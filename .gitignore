# Root .gitignore — StoreRatingHub

# Node modules
node_modules/

# Environment variables (NEVER commit secrets)
.env
.env.*
!.env.example

# Build outputs
dist/
dist-ssr/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS generated
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Prisma generated client (regenerated via `prisma generate`)
backend/node_modules/
backend/dist/

# Frontend build artifacts
frontend/dist/
frontend/dist-ssr/

# Misc
*.local
